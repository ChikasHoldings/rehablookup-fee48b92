# Template for the local .env file. Copy to .env and fill in real values.
# Production values live in the Vercel + Supabase dashboards (Supabase
# secrets live in Project Settings → Edge Functions → Vault).
#
# A "where to get it" hint follows each section.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Both URL pairs MUST point at the same project. A prior audit found a split
# that silently broke the frontend — don't reintroduce it.
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
#
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are auto-injected into
# edge functions by Supabase at runtime — do NOT set them in your local
# .env. They are only here because the edge function code references them.

# ─── Google Analytics 4 ─────────────────────────────────────────────────────
# From: GA4 → Admin → Data Streams → Web stream → Measurement ID
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Flat-fee monetization (Pro / Featured / Concierge). Six price IDs are
# populated by scripts/stripe-setup-monetization.ts (idempotent).
# From: Stripe Dashboard → Products (after running the setup script).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_FEATURED_MONTHLY=
STRIPE_PRICE_FEATURED_ANNUAL=
STRIPE_PRICE_CONCIERGE_MONTHLY=
STRIPE_PRICE_CONCIERGE_ANNUAL=
#
# Edge-function secrets (set in Supabase Vault, NOT in this .env):
#   STRIPE_SECRET_KEY        — Stripe Dashboard → Developers → API keys (sk_...)
#   STRIPE_WEBHOOK_SECRET    — Stripe Dashboard → Developers → Webhooks → endpoint (whsec_...)
#   STRIPE_WEBHOOK_URL       — the deployed stripe-webhook endpoint URL
#
# Client-side publishable key (Vercel env, not Supabase):
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Resend (transactional email) ───────────────────────────────────────────
# Edge-function secrets (set in Supabase Vault):
#   RESEND_API_KEY           — Resend Dashboard → API Keys (re_...)
#   RESEND_WEBHOOK_SECRET    — Resend Dashboard → Webhooks → Signing Secret
#   RESEND_WEBHOOK_URL       — the deployed resend-webhook endpoint URL

# ─── Twilio (SMS + voice OTP) ───────────────────────────────────────────────
# Edge-function secrets (set in Supabase Vault):
#   TWILIO_ACCOUNT_SID       — Twilio Console → Account Info (AC...)
#   TWILIO_AUTH_TOKEN        — Twilio Console → Account Info
#   TWILIO_PHONE_NUMBER      — Twilio Console → Phone Numbers (E.164: +1...)
#   TWILIO_INBOUND_URL       — deployed twilio-sms-inbound endpoint URL
#                              (registered with Twilio via
#                              admin-register-twilio-inbound-webhook)
#   TWILIO_STATUS_CALLBACK_URL — deployed status-callback endpoint URL

# ─── Google Places API ──────────────────────────────────────────────────────
# Edge-function secret (set in Supabase Vault):
#   GOOGLE_PLACES_API_KEY    — Google Cloud Console → APIs & Services →
#                              Credentials. Restrict to HTTPS referrers
#                              `*.supabase.co/*` and the Places API only.

# ─── Cron secret ────────────────────────────────────────────────────────────
# Edge-function secret (set in Supabase Vault):
#   CRON_SECRET              — long random string. Stored in
#                              Supabase → Database → Vault → cron_secret.
#                              pg_cron jobs pass it as the X-Cron-Secret
#                              header when invoking cron-triggered functions.

# ─── Sentry (error tracking) ────────────────────────────────────────────────
# Client-side (Vercel env):
VITE_SENTRY_DSN=""
VITE_SENTRY_RELEASE=""
#
# Edge-function side (Supabase Vault):
#   SENTRY_DSN               — same Sentry project DSN as client
#   SENTRY_ENVIRONMENT       — "production" | "preview" | "development"
#   SENTRY_RELEASE           — git SHA (mirror VERCEL_GIT_COMMIT_SHA)

# ─── Public URLs ────────────────────────────────────────────────────────────
# Used in transactional emails + cross-environment links. Set per-env.
#   PUBLIC_APP_URL           — provider/admin portal root (e.g. https://rehablookup.com)
#   PUBLIC_SITE_URL          — public marketing site root (same value in single-domain)
#   DASHBOARD_URL            — admin dashboard root path

# ─── Provider benchmarks (optional) ─────────────────────────────────────────
# Industry-average CTR shown in the provider analytics dashboard. If unset,
# the UI falls back to a hard-coded benchmark.
# VITE_INDUSTRY_AVG_CTR="3.2"

# ─── Optional helpline override ─────────────────────────────────────────────
# Used by SAMHSA helpline fallbacks. Defaults to +18006624357 if unset.
# VITE_CONCIERGE_HELPLINE="+1XXXXXXXXXX"
# VITE_CONCIERGE_HELPLINE_DISPLAY="(XXX) XXX-XXXX"

# ─── Test / CI only ─────────────────────────────────────────────────────────
# These are documented separately in docs/ci-stripe-e2e-env.md and used by
# the smoke-test runner; never set them in production .env files:
#   SMOKE_ADMIN_EMAIL, SMOKE_ADMIN_PASSWORD, SMOKE_CRON_SECRET
#   STRIPE_TEST_CUSTOMER_ID, STRIPE_TEST_FACILITY_ID, STRIPE_TEST_PROVIDER_USER_ID
#   STRIPE_TEST_PRO_PRICE_ID, STRIPE_TEST_FEATURED_PRICE_ID
#   SUPABASE_TEST_URL, SUPABASE_TEST_SRK
#   TWILIO_TEST_FROM_PHONE, TWILIO_TEST_TO_PHONE

# ─── Auto-provided by runtime (do NOT set) ──────────────────────────────────
# These are populated by the runtime and listed here only to acknowledge
# their use in the codebase:
#   DEV, MODE, PROD          — Vite build mode (`import.meta.env.*`)
#   DENO_DEPLOYMENT_ID       — Deno runtime in edge functions
#   VERCEL_GIT_COMMIT_SHA    — set by Vercel during build
#   SUPABASE_ANON_KEY        — auto-injected into edge functions
#   SUPABASE_SERVICE_ROLE_KEY — auto-injected into edge functions
