# Template for the local .env file. Copy to .env and fill in real values.
# Production values live in the Vercel and Supabase dashboards.

# --- Supabase ---------------------------------------------------------------
# Both pairs MUST point at the same project. The migration audit found a
# split that silently broke the frontend; don't reintroduce it.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# --- Google Analytics 4 -----------------------------------------------------
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Optional helpline override ---------------------------------------------
# Used by SAMHSA helpline fallbacks. Defaults to +18006624357 if unset.
# VITE_CONCIERGE_HELPLINE="+1XXXXXXXXXX"
# VITE_CONCIERGE_HELPLINE_DISPLAY="(XXX) XXX-XXXX"
