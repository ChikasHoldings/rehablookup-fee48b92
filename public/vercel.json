{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/treatment-types/drug-addiction",
      "destination": "/treatment-types/drug-addiction-treatment",
      "permanent": true
    },
    {
      "source": "/treatment-types/dual-diagnosis",
      "destination": "/treatment-types/dual-diagnosis-treatment",
      "permanent": true
    },
    {
      "source": "/insurance/aetna",
      "destination": "/insurance/aetna-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/bcbs",
      "destination": "/insurance/bcbs-treatment",
      "permanent": true
    },
    {
      "source": "/insurance/cigna",
      "destination": "/insurance/cigna-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/humana",
      "destination": "/insurance/humana-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/kaiser",
      "destination": "/insurance/kaiser-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/medicare",
      "destination": "/insurance/medicare-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/medicaid",
      "destination": "/insurance/medicaid-rehab",
      "permanent": true
    },
    {
      "source": "/insurance/united-healthcare",
      "destination": "/insurance/united-healthcare-rehab",
      "permanent": true
    },
    {
      "source": "/request-help",
      "destination": "/concierge",
      "permanent": true
    },
    {
      "source": "/placement-help",
      "destination": "/concierge",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/account",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap-index.xml"
    },
    {
      "source": "/sitemap-facilities.xml",
      "destination": "https://plckxokpyiubuekvodtc.supabase.co/functions/v1/sitemap-facilities"
    },
    {
      "source": "/((?!api|_next|static|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sitemap.*\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/insurance-logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
