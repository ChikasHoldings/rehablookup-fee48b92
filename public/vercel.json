{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/request-help",
      "destination": "/concierge",
      "permanent": true
    },
    {
      "source": "/placement-help", 
      "destination": "/concierge",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/account",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|_next|static|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
