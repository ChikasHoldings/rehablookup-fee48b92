# Netlify redirects for SEO canonicalization
# Last updated: 2026-02-04

# Force trailing slash removal (301 permanent redirect)
# This ensures all URLs resolve to non-trailing-slash versions
# Note: This rule uses regex to catch all paths with trailing slashes
/*/ /:splat 301!

# Badge API endpoint - proxy to edge function
/api/badge/* https://plckxokpyiubuekvodtc.supabase.co/functions/v1/serve-badge/:splat 200

# Sitemaps - All routed through sitemap-facilities function (consolidated)
/sitemap.xml https://plckxokpyiubuekvodtc.supabase.co/functions/v1/sitemap-facilities?type=main 200!
/sitemap-index.xml https://plckxokpyiubuekvodtc.supabase.co/functions/v1/sitemap-facilities?type=index 200!
/sitemap-facilities.xml https://plckxokpyiubuekvodtc.supabase.co/functions/v1/sitemap-facilities?type=facilities 200!

# Force HTTPS and www normalization (if needed)
# http://rehablookup.com/* https://rehablookup.com/:splat 301!
# http://www.rehablookup.com/* https://rehablookup.com/:splat 301!
# https://www.rehablookup.com/* https://rehablookup.com/:splat 301!

# Redirect duplicate treatment type routes to canonical versions
/treatment-types/drug-addiction /treatment-types/drug-addiction-treatment 301!
/treatment-types/dual-diagnosis /treatment-types/dual-diagnosis-treatment 301!

# Redirect insurance short URLs to canonical versions (prevent soft 404s)
/insurance/aetna /insurance/aetna-rehab 301!
/insurance/bcbs /insurance/bcbs-treatment 301!
/insurance/cigna /insurance/cigna-rehab 301!
/insurance/humana /insurance/humana-rehab 301!
/insurance/kaiser /insurance/kaiser-rehab 301!
/insurance/medicare /insurance/medicare-rehab 301!
/insurance/medicaid /insurance/medicaid-rehab 301!
/insurance/united-healthcare /insurance/united-healthcare-rehab 301!

# Redirect legacy /treatment/ URLs to canonical /treatment-types/ versions
/treatment/dual-diagnosis /treatment-types/dual-diagnosis-treatment 301!
/treatment/dual-diagnosis/:state /treatment-types/dual-diagnosis-treatment/:state 301!
/treatment/detox /treatment-types/detox-programs 301!
/treatment/detox/:state /treatment-types/detox-programs/:state 301!

# Redirect old/deprecated URLs to canonical versions
/request-help /concierge 301!
/request-help/* /concierge 301!
/placement-help /concierge 301!
/my-account /account 301!

# =============================================================================
# SEO PRERENDERING: Bot requests are handled by edge functions
# The detect-and-prerender edge function intercepts bot User-Agents and
# proxies them to prerender-for-bots for server-rendered HTML.
# 
# For Netlify/Vercel deployments without edge function support at the CDN level,
# the index.html contains homepage-only <noscript> content as fallback.
# Legal pages (privacy-policy, terms-of-service) are served as static HTML files.
# =============================================================================

# Redirect /sitemap to sitemap.xml (prevent SPA shell from being indexed)
/sitemap /sitemap.xml 301

# Static pages - served directly to ensure clean, focused SEO content
# These bypass the SPA shell so crawlers see dedicated page content
/privacy-policy /privacy-policy.html 200
/terms-of-service /terms-of-service.html 200
/for-providers /for-providers.html 200
/about /about.html 200
/contact /contact.html 200
/how-it-works /how-it-works.html 200
# /resources - Now served by React SPA (removed static redirect to fix image display)
/concierge /concierge.html 200
/international /international.html 200
/treatment-types /treatment-types.html 200
/insurance /insurance.html 200
/locations /locations.html 200
/cost-estimator /cost-estimator.html 200

# Insurance static pages with FAQPage schema for rich snippets
/insurance/aetna-rehab /insurance/aetna-rehab.html 200
/insurance/bcbs-treatment /insurance/bcbs-treatment.html 200
/insurance/cigna-rehab /insurance/cigna-rehab.html 200
/insurance/united-healthcare-rehab /insurance/united-healthcare-rehab.html 200
/insurance/medicare-rehab /insurance/medicare-rehab.html 200

# Handle SPA routing - serve index.html for all other routes
/* /index.html 200
