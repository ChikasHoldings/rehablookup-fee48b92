# Netlify redirects for SEO canonicalization
# Last updated: 2026-02-02

# Force trailing slash removal (301 permanent redirect)
# This ensures all URLs resolve to non-trailing-slash versions
# Note: This rule uses regex to catch all paths with trailing slashes
/*/ /:splat 301!

# Force HTTPS and www normalization (if needed)
# http://rehablookup.com/* https://rehablookup.com/:splat 301!
# http://www.rehablookup.com/* https://rehablookup.com/:splat 301!
# https://www.rehablookup.com/* https://rehablookup.com/:splat 301!

# Redirect duplicate treatment type routes to canonical versions
/treatment-types/drug-addiction /treatment-types/drug-addiction-treatment 301
/treatment-types/dual-diagnosis /treatment-types/dual-diagnosis-treatment 301

# Redirect insurance short URLs to canonical versions (prevent soft 404s)
/insurance/aetna /insurance/aetna-rehab 301
/insurance/bcbs /insurance/bcbs-treatment 301
/insurance/cigna /insurance/cigna-rehab 301
/insurance/humana /insurance/humana-rehab 301
/insurance/kaiser /insurance/kaiser-rehab 301
/insurance/medicare /insurance/medicare-rehab 301
/insurance/medicaid /insurance/medicaid-rehab 301
/insurance/united-healthcare /insurance/united-healthcare-rehab 301

# Redirect old/deprecated URLs to canonical versions
# Note: /request-help and /placement-help redirects are handled in React Router
/my-account /account 301

# =============================================================================
# SEO PRERENDERING: Bot requests are handled by edge functions
# The detect-and-prerender edge function intercepts bot User-Agents and
# proxies them to prerender-for-bots for server-rendered HTML.
# 
# For Netlify/Vercel deployments without edge function support at the CDN level,
# the index.html contains homepage-only <noscript> content as fallback.
# Legal pages (privacy-policy, terms-of-service) are served as static HTML files.
# =============================================================================

# Static legal pages - served directly to ensure clean, focused SEO content
# These bypass the SPA shell so crawlers see dedicated legal page content
/privacy-policy /privacy-policy.html 200
/terms-of-service /terms-of-service.html 200

# Handle SPA routing - serve index.html for all other routes
/* /index.html 200
