# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — never commit. Use .env.example as a template
# checked into git; actual values go in .env (local) or in the Vercel /
# Supabase dashboards (production).
.env
.env.*
!.env.example

# Script-generated reports — outputs of scripts/check-broken-links.mjs and
# scripts/crawl-live-404s.mjs. Regenerated locally / in CI; don't track.
broken-links-report.md
crawl-404-report.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright run artifacts. `playwright test` writes error-context.md /
# screenshots / traces here on failure, and --update-snapshots writes new
# baselines next to the specs. Neither belongs in git — a `git add -A` after a
# local E2E run would otherwise sweep in hundreds of generated files.
test-results/
playwright-report/
blob-report/
