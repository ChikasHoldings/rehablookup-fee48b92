{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.rehablookup.com" }], "destination": "https://rehablookup.com/:path*", "permanent": true },
    { "source": "/:path+/", "destination": "/:path+", "permanent": true },

    { "//": "Concierge — legacy /request-help/* paths", "source": "/request-help", "destination": "/concierge", "permanent": true },
    { "source": "/request-help/intake", "destination": "/concierge/intake", "permanent": true },
    { "source": "/request-help/thank-you", "destination": "/concierge/thank-you", "permanent": true },
    { "source": "/request-help/create-password", "destination": "/concierge/thank-you", "permanent": true },
    { "source": "/concierge/create-password", "destination": "/concierge/thank-you", "permanent": true },
    { "source": "/placement-help", "destination": "/concierge", "permanent": true },

    { "//": "Treatment-types canonical slug consolidation", "source": "/treatment-types/drug-addiction", "destination": "/treatment-types/drug-addiction-treatment", "permanent": true },
    { "source": "/treatment-types/dual-diagnosis", "destination": "/treatment-types/dual-diagnosis-treatment", "permanent": true },
    { "source": "/treatment-types/holistic-treatment", "destination": "/treatment-types/holistic-therapy", "permanent": true },
    { "source": "/treatment/dual-diagnosis", "destination": "/treatment-types/dual-diagnosis-treatment", "permanent": true },
    { "source": "/treatment/detox", "destination": "/treatment-types/detox-programs", "permanent": true },
    { "source": "/treatment/inpatient-rehab", "destination": "/treatment-types/residential-inpatient", "permanent": true },
    { "source": "/treatment/alcohol-rehab", "destination": "/treatment-types/alcohol-rehabilitation", "permanent": true },
    { "source": "/lp/treatment", "destination": "/treatment-types", "permanent": true },
    { "source": "/treatment", "destination": "/treatment-types", "permanent": true },

    { "//": "Discovery shorthand → canonical directory", "source": "/centers", "destination": "/rehab-centers", "permanent": true },
    { "source": "/find-rehab", "destination": "/rehab-centers", "permanent": true },
    { "source": "/find-treatment", "destination": "/rehab-centers", "permanent": true },
    { "source": "/rehab", "destination": "/rehab-centers", "permanent": true },
    { "source": "/directory", "destination": "/rehab-centers", "permanent": true },
    { "source": "/blog", "destination": "/resources", "permanent": true },
    { "source": "/search", "destination": "/search-results", "permanent": true },
    { "source": "/sitemap", "destination": "/sitemap-index.xml", "permanent": true },

    { "//": "Typo / canonical aliases", "source": "/detox-centers-centers", "destination": "/detox-centers", "permanent": true },
    { "source": "/rehab-vs-detox", "destination": "/detox-vs-rehab", "permanent": true },
    { "source": "/what-is-intensive-outpatient", "destination": "/what-is-iop", "permanent": true },

    { "//": "International / US-rehab — canonical lives at /best-rehab-centers-in-usa", "source": "/us-rehab/best-rehab-usa", "destination": "/best-rehab-centers-in-usa", "permanent": true },
    { "source": "/us-rehab/detox-usa", "destination": "/treatment-types/detox-programs", "permanent": true },
    { "source": "/us-rehab/california", "destination": "/rehab-centers/california", "permanent": true },
    { "source": "/rehab-in-usa-for-canadians", "destination": "/us-rehab/canadian-patients", "permanent": true },
    { "source": "/rehab-in-usa-for-uk-patients", "destination": "/us-rehab/uk-patients", "permanent": true },
    { "source": "/rehab-in-usa-for-international-patients", "destination": "/international", "permanent": true },
    { "source": "/best-rehab-centers-in-usa-for-foreigners", "destination": "/can-foreigners-go-to-rehab-in-usa", "permanent": true },
    { "source": "/luxury-rehab-centers-usa", "destination": "/us-rehab/luxury-rehab-america", "permanent": true },
    { "source": "/private-rehab-usa", "destination": "/us-rehab/private-rehab-america", "permanent": true },
    { "source": "/confidential-rehab-usa", "destination": "/us-rehab/private-rehab-america", "permanent": true },
    { "source": "/international/intake", "destination": "/international/apply", "permanent": true },

    { "//": "Insurance — legacy short slugs → SEO-targeted ones", "source": "/insurance/aetna", "destination": "/insurance/aetna-rehab", "permanent": true },
    { "source": "/insurance/bcbs", "destination": "/insurance/bcbs-treatment", "permanent": true },
    { "source": "/insurance/cigna", "destination": "/insurance/cigna-rehab", "permanent": true },
    { "source": "/insurance/united-healthcare", "destination": "/insurance/united-healthcare-rehab", "permanent": true },
    { "source": "/insurance/humana", "destination": "/insurance/humana-rehab", "permanent": true },
    { "source": "/insurance/kaiser", "destination": "/insurance/kaiser-rehab", "permanent": true },
    { "source": "/insurance/medicare", "destination": "/insurance/medicare-rehab", "permanent": true },
    { "source": "/insurance/medicaid", "destination": "/insurance/medicaid-rehab", "permanent": true },
    { "source": "/insurance/anthem", "destination": "/insurance/anthem-rehab", "permanent": true },

    { "//": "Legal & account — order matters: child paths BEFORE /seeker catch-all", "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms", "destination": "/terms-of-service", "permanent": true },
    { "source": "/signup", "destination": "/seeker/signup", "permanent": true },
    { "source": "/reset-password", "destination": "/seeker/reset-password", "permanent": true },
    { "source": "/seeker", "destination": "/client", "permanent": true },

    { "//": "Provider — child paths must come before /provider-login style aliases", "source": "/provider-reset-password", "destination": "/provider/reset-password", "permanent": true },
    { "source": "/provider/login", "destination": "/login", "permanent": true },
    { "source": "/provider-login", "destination": "/login", "permanent": true },
    { "source": "/provider/support", "destination": "/provider-support", "permanent": true },
    { "source": "/provider/faq", "destination": "/provider-faq", "permanent": true },
    { "source": "/provider/signup", "destination": "/provider-signup", "permanent": true },
    { "source": "/provider-guides", "destination": "/provider-resources", "permanent": true },
    { "source": "/admin-login", "destination": "/admin/login", "permanent": true },

    { "//": "Catch-alls (must be LAST in their group — wildcards greedy)", "source": "/my-account/:path*", "destination": "/account", "permanent": true },
    { "source": "/lp/social", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$|api/|assets/|_next/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|woff2|woff|ttf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "github": { "silent": true }
}
