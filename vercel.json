{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.rehablookup.com" }],
      "destination": "https://rehablookup.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/request-help",
      "destination": "/concierge",
      "permanent": true
    },
    {
      "source": "/request-help/intake",
      "destination": "/concierge/intake",
      "permanent": true
    },
    {
      "source": "/request-help/thank-you",
      "destination": "/concierge/thank-you",
      "permanent": true
    },
    {
      "source": "/request-help/create-password",
      "destination": "/concierge/thank-you",
      "permanent": true
    },
    {
      "source": "/us-rehab/best-rehab-usa",
      "destination": "/best-rehab-centers-in-usa",
      "permanent": true
    },
    {
      "source": "/detox-centers-centers",
      "destination": "/detox-centers",
      "permanent": true
    },
    {
      "source": "/treatment/dual-diagnosis",
      "destination": "/treatment-types/dual-diagnosis",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$|api/|assets/|_next/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|woff2|woff|ttf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "github": { "silent": true }
}
